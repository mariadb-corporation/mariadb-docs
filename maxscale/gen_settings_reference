#
# This script extracts the configuration settings of MaxScale
# and outputs a file containing them all.
#
# The output, reference/maxscale-configuration-settings.md, is generated.
# Never edit it by hand, in Git or in the GitBook editor: the next run
# overwrites every hand edit. Change the module page the setting comes
# from, then rerun this script.
#
# A setting is identified by scanning for "* Type" and that
# line and every following line beginning with "* " are assumed
# to be documentation for the parameter named in the heading above
# the "* Type" line.
#
# Every group of settings should be under a heading "Settings"
# whose heading level should be one less than the level of the
# settings.
#
#     ## Settings
#
#     ### `param`
#
#     * Type: string
#     * Mandatory: No
#     * Dynamic: Yes
#     * Default: None
#     * Description: One sentence that says what the setting does.
#
# The "* Description:" bullet is what the settings reference shows
# for the setting, so every setting should have one. The script lists
# the settings that have none on stderr.
#
# A setting may also be named by a bold paragraph instead of a heading,
# as the key manager settings are:
#
#     #### Settings for File-based Key Manager
#
#     **`file.keyfile`**
#
#     * Type: path
#
# Its link then points at the heading above the bold paragraph.
#
# In case there are more groups, then the general group should
# have the heading "Settings" and more specific groups then
# something like "Settings for XYZ". Since the groups will be
# ordered alphabetically, that ensures that the general settings
# are listed first.
#
# This script should be invoked in the "mariadb-docs/maxscale" directory
# and the output redirected to the file
# reference/maxscale-configuration-settings.md
#
# $ ./gen_settings_reference > reference/maxscale-configuration-settings.md
#
# Link anchors use the GitBook slug rules of the repository's fragment
# checker (.claude/hooks/fragcheck.py), so the links it writes resolve.
# See dev-docs/cookbook-maxscale-settings-reference.md.
#

import os
import re
import sys

from collections import deque

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", ".claude", "hooks"))
from fragcheck import gitbook_slug

link_pattern = r'\[([^\]]+)\]\(([^)]+)\)'
bold_name_pattern = r'^\*\*`?([^*`]+)`?\*\*$'

# A setting name is an identifier such as threads or vault.host. Pages
# that are not module pages (the REST API resources, the telemetry
# metrics) also have "* Type" bullets, under headings such as
# "Create a filter"; this tells them apart.
setting_name_pattern = r'^[a-z][A-Za-z0-9_.]*$'

# Links in the output are relative to the page being generated.
output_dir = "reference"

# The deepest heading level GitBook gives an anchor to. Deeper groups
# are printed as bold paragraphs instead.
max_heading_level = 4

missing_descriptions = []

def relative_to_output(path):
    return os.path.relpath(path, output_dir)

def escape(name):
    return name.replace("_", "\\_")

class Entry:
    def __init__(self, name, path, anchor):
        self.name = name
        self.path = path
        self.anchor = anchor
        self.lines = []

    def modify_link(self, match):
        name = match.group(1)
        link = match.group(2)

        if re.match(r'^[a-z]+:', link):
            return match.group(0)

        parts = link.split("#", 1)
        path = parts[0]
        entry = parts[1] if len(parts) > 1 else ""

        # Resolve the link against the module page it was written in,
        # then make it relative to the generated page.
        if path:
            path = os.path.normpath(os.path.join(os.path.dirname(self.path), path))
        else:
            path = self.path

        link = relative_to_output(path)
        if entry:
            link += "#" + entry

        return f'[{name}]({link})'

    def add(self, line):
        line = re.sub(link_pattern, self.modify_link, line)

        self.lines.append(line)

    def block(self):
        if not any(line.startswith("* Description:") for line in self.lines):
            missing_descriptions.append(self.path + ": " + self.name)

        link = relative_to_output(self.path) + "#" + self.anchor
        return "[**" + escape(self.name) + "**](" + link + ")\n\n" + "\n".join(self.lines)

class Header:
    def __init__(self, depth, line):
        self.name = line.lstrip("# ")
        self.depth = depth
        self.line = line

class Headers:
    def __init__(self):
        self.headers = deque()
        self.in_code = False

    def check(self, line):
        if line[:3] == "```":
            self.in_code = not self.in_code
        elif not self.in_code:
            match = re.match(r'^##*', line)
            if match:
                depth=len(match.group(0))
                while len(self.headers) > 0 and self.headers[-1].depth >= depth:
                    self.headers.pop()
                self.headers.append(Header(depth, line))
        else:
            None

    def current(self):
        if len(self.headers) >= 1:
            return self.headers[-1]
        else:
            return None

    def prev(self):
        if len(self.headers) >= 2:
            return self.headers[-2]
        else:
            return None

def setting_name(lines, i, headers):
    """Return (name, anchor, group) of the setting whose "* Type" is lines[i]."""
    j = i - 1
    while j >= 0 and not lines[j]:
        j -= 1

    if j >= 0:
        match = re.match(bold_name_pattern, lines[j])
        if match and headers.current():
            heading = headers.current().name
            return match.group(1).strip(), gitbook_slug(heading), heading

    if not headers.current() or not headers.prev():
        return None, None, None

    heading = headers.current().name
    name = heading.strip("`").strip()
    return name, gitbook_slug(heading), headers.prev().name

def scan_lines(entries, path, lines, indented):
    i=0
    end = len(lines)
    headers=Headers()
    while i < end:
        line = lines[i]
        headers.check(line)
        if line.startswith("* Type") and not headers.in_code:
            name, anchor, group = setting_name(lines, i, headers)

            if name and re.match(setting_name_pattern, name):
                relevant_entries = entries.get(group)
                if not relevant_entries:
                    relevant_entries = {}
                    entries[group] = relevant_entries

                # A bullet may continue on indented lines, which are joined to it.
                bullets = [line]
                i += 1
                while i < end and (lines[i].startswith("*") or (indented[i] and lines[i])):
                    if lines[i].startswith("*"):
                        bullets.append(lines[i])
                    else:
                        bullets[-1] += " " + lines[i]
                    i += 1

                entry = Entry(name, path, anchor)
                for bullet in bullets:
                    entry.add(bullet)
                relevant_entries[entry.name] = entry
            else:
                i += 1
        else:
            i += 1

def scan_md_file(entries, path):
    with open(path) as fin:
        try:
            lines=fin.readlines()
            indented=[line[:1] in (" ", "\t") for line in lines]
            lines=[line.strip() for line in lines]
        except UnicodeDecodeError:
            print("warning Could not decode file, ignoring.", file=sys.stderr)
            return
        except:
            print("warning: Could not read file, ignoring.", file=sys.stderr)
            return

    scan_lines(entries, path, lines, indented)

def scan_file(entries, path):
    if os.path.isdir(path):
        scan_path(entries, path)
    elif path.endswith(".md"):
        name=path.split('/')[-1].replace('.md', '')
        if path.endswith("maxscale-configuration-settings.md"):
            return
        if name=="maxscale-configuration-guide":
            name="MaxScale"
        scope="[" + name + "](" + relative_to_output(path) + ")"
        sub_entries=entries.get(scope)
        if not sub_entries:
            sub_entries={}
            entries[scope] = sub_entries;
        scan_md_file(sub_entries, path)

def scan_dir(entries, dir):
    for file in os.listdir(dir):
        path=dir + "/" + file
        scan_file(entries, path)

def scan_path(entries, path):
    if not os.path.exists(path):
        print("warning: " + path + " does not exist.", file=sys.stderr)
    elif os.path.isdir(path):
        sub_entries=entries.get(path)
        if not sub_entries:
            sub_entries = {}
            entries[path] = sub_entries
        scan_dir(sub_entries, path)
    elif os.path.isfile(path):
        i = path.find("/")
        dir=path[:i]
        sub_entries=entries.get(dir)
        if not sub_entries:
            sub_entries = {}
            entries[dir]=sub_entries
        scan_file(sub_entries, path)
    else:
        print("warning: '" + path + "' is not a regular file or directory, ignoring.", file=sys.stderr)

def scan_paths(paths):
    entries = {}
    for path in paths:
        scan_path(entries, path)

    return entries

def title(name, level):
    if level <= max_heading_level:
        return "#" * level + " " + name
    else:
        return "**" + name + "**"

def has_settings(entries):
    return any(not isinstance(entry, dict) or has_settings(entry)
               for entry in entries.values())

def entry_blocks(entries, level):
    blocks = []
    keys = sorted(entries.keys())
    for key in keys:
        entry = entries[key]

        if not isinstance(entry, dict):
            blocks.append(entry.block())

    for key in keys:
        entry = entries[key]

        if isinstance(entry, dict):
            if has_settings(entry):
                blocks.append(title(key, level))
                blocks += entry_blocks(entry, level + 1)

    return blocks

def main(argv):
    name=argv[0]
    args=argv[1:]

    if not args:
        args = ("maxscale-management/deployment/installation-and-configuration/maxscale-configuration-guide.md", "reference")

    entries = scan_paths(args)

    blocks = []

    getting_started = entries.pop("maxscale-management", None)

    if getting_started:
        blocks.append("## General")
        blocks += entry_blocks(getting_started, 3)

    blocks += entry_blocks(entries, 2)

    print("---")
    print("description: >-")
    print("  Browse the comprehensive list of MariaDB MaxScale configuration parameters.")
    print("  This reference details valid values, default settings, and dynamic")
    print("  capabilities for servers, services, and monitors.")
    print("---")
    print()
    print("<!--")
    print("  GENERATED by maxscale/gen_settings_reference. Do not edit this page, in Git")
    print("  or in the GitBook editor: the next run overwrites every hand edit.")
    print()
    print("  To change an entry, edit the setting's module page (the page its link")
    print("  points to), then regenerate this page on a local machine, from the")
    print("  mariadb-docs/maxscale directory:")
    print()
    print("    ./gen_settings_reference > reference/maxscale-configuration-settings.md")
    print()
    print("  and commit the module page and this page together, in one pull request.")
    print("  See dev-docs/cookbook-maxscale-settings-reference.md.")
    print("-->")
    print()
    print("# MaxScale Configuration Settings")
    print()
    print("\n\n".join(blocks))
    print()
    print("***")
    print()
    print("<sub>_This page is licensed: CC BY-SA / Gnu FDL_</sub>")
    print()
    print('{% @marketo/form formId="4316" %}')

    if missing_descriptions:
        print(str(len(missing_descriptions)) + " settings have no \"* Description:\" bullet:",
              file=sys.stderr)
        for missing in missing_descriptions:
            print("  " + missing, file=sys.stderr)

if __name__ == "__main__":
    main(sys.argv)
